  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid",
            "title": "Gameid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "title": "Requestid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expectedversion"
          },
          "action": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ExploreAction"
              },
              {
                "$ref": "#/components/schemas/AnswerAction"
              },
              {
                "$ref": "#/components/schemas/TravelAction"
              }
            ],
            "title": "Action",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "answerQuestion": "#/components/schemas/AnswerAction",
                "chooseRoute": "#/components/schemas/TravelAction",
                "exploreScene": "#/components/schemas/ExploreAction"
              }
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "gameId",
          "requestId",
          "expectedVersion",
          "action"
        ],
        "title": "ActionRequest"
      },
      "AnswerAction": {
        "properties": {
          "type": {
            "type": "string",
            "const": "answerQuestion",
            "title": "Type"
          },
          "questionId": {
            "type": "string",
            "title": "Questionid"
          },
          "optionId": {
            "type": "string",
            "title": "Optionid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "questionId",
          "optionId"
        ],
        "title": "AnswerAction"
      },
      "CatalogResponse": {
        "properties": {
